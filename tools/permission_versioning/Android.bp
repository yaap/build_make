package {
    default_applicable_licenses: ["Android-Apache-2.0"],
    default_team: "trendy_team_android_permissions",
}

java_binary_host {
    name: "permission_versions_generator",
    main_class: "com.android.permissionversioning.PermissionVersionsDriver",
    static_libs: [
        "permission_versions_lib",
    ],
}

java_library_host {
    name: "permission_versions_lib",
    srcs: [
        "src/**/*.kt",
    ],
    static_libs: [
        "libaconfig_java_proto_lite",
        "kotlin-stdlib",
    ],
}

java_test_host {
    name: "permission_versions_tests",
    srcs: [
        "tests/src/**/*.kt",
    ],
    static_libs: [
        "junit",
        "permission_versions_lib",
        "truth",
    ],
    test_options: {
        unit_test: true,
    },
}
