package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

rust_defaults {
    name: "unpack-platform-sdk-defaults",
    edition: "2021",
    clippy_lints: "android",
    lints: "android",
    use_expansive_default_srcs: false,
    rustlibs: [
        "libanyhow",
        "libclap",
        "libregex",
        "libwalkdir",
        "libzip",
    ],
    crate_root: "src/main.rs",
}

rust_binary_host {
    name: "unpack-platform-sdk",
    defaults: ["unpack-platform-sdk-defaults"],
    srcs: ["src/*.rs"],
}

rust_test_host {
    name: "unpack-platform-sdk-test",
    defaults: ["unpack-platform-sdk-defaults"],
    srcs: [
        "src/*.rs",
    ],
    test_suites: ["general-tests"],
}
