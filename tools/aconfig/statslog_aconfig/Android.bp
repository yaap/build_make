// Autogenerate the class (and respective headers) with logging methods and constants
package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

// Similarly to fake_device_config, we build the statslog_aconfig_java libraries against these stubs
// of classes that aren't available with their sdk_version but will be available at runtime.
java_library {
    name: "statslog_aconfig_java_stubs",
    srcs: ["stubs/**/*.java"],
    sdk_version: "core_current",
    system_modules: "none",
    host_supported: true,
    is_stubs_module: true,
}

genrule {
    name: "statslog-aconfig-java-gen-platform",
    tools: ["stats-log-api-gen"],
    cmd: "$(location stats-log-api-gen) --java $(out) --module aconfig " +
        "--javaPackage android.aconfig.statslog --javaClass AconfigStatsLog",
    out: ["android/aconfig/statslog/AconfigStatsLog.java"],
}

java_library {
    name: "libstatslog_aconfig_java_platform",
    srcs: [":statslog-aconfig-java-gen-platform"],
    libs: ["statslog_aconfig_java_stubs"],
    sdk_version: "core_current",
    system_modules: "none",
    host_supported: true,
}

genrule {
    name: "statslog-aconfig-java-gen-mainline",
    tools: ["stats-log-api-gen"],
    cmd: "$(location stats-log-api-gen) --java $(out) --module aconfig " +
        "--javaPackage android.os.flagging.statslog --javaClass AconfigStatsLog",
    out: ["android/os/flagging/statslog/AconfigStatsLog.java"],
}

java_library {
    name: "libstatslog_aconfig_java_mainline",
    srcs: [":statslog-aconfig-java-gen-mainline"],
    libs: ["statslog_aconfig_java_stubs"],
    sdk_version: "core_current",
    system_modules: "none",
    apex_available: ["com.android.configinfrastructure"],
    host_supported: true,
}
