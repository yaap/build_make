package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

rust_defaults {
    name: "record-finalized-flags-defaults",
    edition: "2021",
    clippy_lints: "android",
    lints: "android",
    rustlibs: [
        "libanyhow",
        "libclap",
        "libregex",
    ],
}

rust_binary_host {
    name: "record-finalized-flags",
    defaults: ["record-finalized-flags-defaults"],
    crate_root: "src/main.rs",
    srcs: ["src/*.rs"],
    use_expansive_default_srcs: false,
}

rust_test_host {
    name: "record-finalized-flags-test",
    defaults: ["record-finalized-flags-defaults"],
    crate_root: "src/main.rs",
    srcs: [
        "src/*.rs",
        "tests/finalized-flags.txt",
        "tests/flag-report.csv",
    ],
    use_expansive_default_srcs: false,
    test_suites: ["general-tests"],
}
